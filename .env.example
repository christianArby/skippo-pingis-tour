# Detta är endast dokumentation - appen läser inte från .env-filer.
# Webbappens Firebase-config ligger i window.FIREBASE_CONFIG i index.html
# (den är publik — åtkomsten styrs av firestore.rules).
#
# Slack-webhooken för #pingis är en hemlighet i Cloud Functions:
#   firebase functions:secrets:set SLACK_WEBHOOK_URL
#
# För scripts/import-slack.mjs:
SLACK_BOT_TOKEN=xoxb-...
GOOGLE_APPLICATION_CREDENTIALS=~/pingis-sa.json   # service account-nyckel, aldrig i repot
